// Bell pair: the smallest circuit with a two-qubit entangling gate, so the
// compiler has an operation that qubit connectivity could constrain.
func.func @__nvqpp__mlirgen__bell() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %0 = quake.alloca !quake.veq<2>
  %q0 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
  %q1 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
  quake.h %q0 : (!quake.ref) -> ()
  quake.x [%q0] %q1 : (!quake.ref, !quake.ref) -> ()
  %meas = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
  return
}
