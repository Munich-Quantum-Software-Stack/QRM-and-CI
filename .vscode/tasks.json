{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "build",
            "command": "sh install.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": ["kill_deamon"]
        },
        {
            "label": "kill_deamon",
            "command": "sh ${workspaceFolder}/scripts/kill_daemons.sh",
