# Shared environment for apps/distributed/docker-compose.yaml's selector and
# worker services. Copy this file to `.env` in this directory and edit it --
# see docs/getting-started.md's "Runtime configuration" section for the
# full defaults < file < environment variable precedence and env var
# contract. Do not commit a copy of this file containing real credentials.
#
# Both services load this same file: their [common] connection and queue
# names must match, since they share one broker and the compiler/backend-
# status queues between them.

# --- RabbitMQ connection (shared) --------------------------------------
# "localhost" here would mean each container's own loopback, not the shared
# external broker these services are meant to connect to.
QRMCI_AMQP_HOST=localhost
QRMCI_AMQP_PORT=5672
QRMCI_AMQP_USER=guest
QRMCI_AMQP_PASSWORD=guest
QRMCI_AMQP_VHOST=/

# --- Queues (shared) -------------------------------------------------
# Input queue the selector receives incoming tasks from.
QRMCI_QRMCI_QUEUE=qrmci.tasks.queue
# Queue used by the scheduler stage (currently unused by any stage).
QRMCI_SCHEDULER_QUEUE=scheduler.tasks.queue
# Queue that carries execution results (informational; result delivery
# actually uses each task's own result_destination).
QRMCI_RESULTS_QUEUE=test.results.queue
# Queue the worker publishes its own backend status to, and the selector
# reads backend status from.
QRMCI_BACKEND_STATUS_QUEUE=backend.status.queue
# Queue the selector forwards selected tasks to, and the worker receives
# already-selected tasks from. The worker also publishes this as its own
# backend status's queue_name, so the selector routes every task it assigns
# to that worker back to this exact queue -- in a multi-worker deployment,
# each worker needs a distinct value here (and a distinct
# QRMCI_SUBMITTER_QDMI_DEVICE_ID below), e.g. via a per-service `environment:`
# override in docker-compose.yaml, or the selector will reject the second
# worker's status as an identity collision. A single-worker deployment can
# keep this shared default.
QRMCI_COMPILER_QUEUE=compiler.tasks.queue

# --- Logging (shared) -------------------------------------------------
# Must match the container-side mount point of each service's `volumes:`
# log mapping in docker-compose.yaml (default /home/qrmci/logs) for logs to
# land on the host.
QRMCI_LOG_DIR=/home/qrmci/logs

# --- QDMI / submitter (worker only; parsed but unused by the selector) ---
# Queue used by the submitter stage (currently unused by any stage).
QRMCI_SUBMITTER_QUEUE=submitter.tasks.queue
# Filesystem path (inside the container) to the QDMI driver library. The
# worker checks that the file exists before loading it and does not search
# the library path, so a bare library stem will not be found. The driver's
# QDMI version is detected from the driver itself and is not configured.
QRMCI_SUBMITTER_QDMI_DRIVER=/usr/local/lib/qrmci/libqdmi_example_driver.so
QRMCI_SUBMITTER_QDMI_DEVICE_NAME=C++ Device with 5 qubits
# The client-facing backend ID: the registry key this worker's status is
# published under, and what QuantumTask's preferred_qpu/restricted_resource_names
# and QuantumResult's executed_qpu actually match against -- not
# QRMCI_SUBMITTER_QDMI_DEVICE_NAME above, which is only the QDMI device's own
# display name. Must be unique across workers sharing one selector; see
# QRMCI_COMPILER_QUEUE above.
QRMCI_SUBMITTER_QDMI_DEVICE_ID=cxxdevice5q
# Prefer setting this at deploy time over committing a real token.
QRMCI_SUBMITTER_QDMI_CLIENT_TOKEN=token

# --- Config file (optional; each service mounts its own file at this same
# in-container path) -----------------------------------------------------
# Path (inside the container) to a TOML file for settings with no QRMCI_*
# env var (poll interval, receive timeout, job wait timeout, registry TTL,
# logger names) --
# see apps/qrmci.full-reference.example.toml. Mount it via the
# commented-out `volumes:` entry per service in docker-compose.yaml first.
# QRMCI_CONFIG_FILE=/home/qrmci/config/qrmci.toml

# --- Compose-only (not read by either daemon) ---------------------------
# Tag applied to the locally built images.
IMAGE_TAG=local
# Optional GitHub token (e.g. a fine-grained PAT with read access to
# Munich-Quantum-Software-Stack repos), used only during `docker compose
# build` to authenticate the builder stage's FetchContent git clones over
# HTTPS. Leave unset for unauthenticated HTTPS (works for public repos).
GITHUB_TOKEN=
