PROJECT_NAME           = "Quantum Resource Manager and Compiler Infrastructure (QRM&CI)"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
PROJECT_LOGO           = _static/@PROJECT_LOGO@

OUTPUT_DIRECTORY       = "@QRMCI_DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO

INPUT                  = @QRMCI_DOXYGEN_INPUT_DIRS@
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.md
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/index.md"

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
INPUT_ENCODING         = UTF-8

TOC_INCLUDE_HEADINGS   = 0

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 360
DISABLE_INDEX          = YES
FULL_SIDEBAR           = YES
SOURCE_BROWSER         = YES
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
FULL_PATH_NAMES        = NO
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
LAYOUT_FILE            = layout.xml
HTML_HEADER            = header.html

HTML_EXTRA_STYLESHEET  = "@AWESOME_CSS_DIR@/doxygen-awesome.css" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/style.css"
HTML_EXTRA_FILES       = "@AWESOME_CSS_DIR@/doxygen-awesome-darkmode-toggle.js" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-fragment-copy-button.js" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-paragraph-link.js" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-interactive-toc.js" \
                         "@AWESOME_CSS_DIR@/doxygen-awesome-tabs.js"
HTML_COLORSTYLE        = LIGHT
HTML_DYNAMIC_MENUS     = NO
SEARCHENGINE           = NO
