#pragma once

#include <string_view>

namespace mqss::qrmci::defaults {

// Static defaults.
inline constexpr std::string_view AMQPHost = "127.0.0.1";
inline constexpr int AMQPPort = 5672;
inline constexpr std::string_view AMQPUser = "guest";
inline constexpr std::string_view AMQPPassword = "guest";
inline constexpr std::string_view AMQPVHost = "/";

inline constexpr std::string_view QRMCIQueue = "qrmci.tasks.queue";
inline constexpr std::string_view SchedulerQueue = "scheduler.tasks.queue";
inline constexpr std::string_view CompilerQueue = "compiler.tasks.queue";
inline constexpr std::string_view ResultsQueue = "test.results.queue";
inline constexpr std::string_view SubmitterQueue = "submitter.tasks.queue";
inline constexpr std::string_view BackendStatusQueue = "backend.status.queue";

inline constexpr std::string_view LogDir = "/var/log/qrmci";
inline constexpr std::string_view CompilerLog = "compiler.log";
inline constexpr std::string_view SchedulerLog = "scheduler.log";
inline constexpr std::string_view DaemonLog = "daemon.log";
inline constexpr std::string_view SubmitterLog = "submitter.log";
inline constexpr std::string_view SelectorLog = "selector.log";

// Matches where the runtime container images install the driver (see
// apps/standalone/Dockerfile, apps/distributed/Dockerfile).
// openConfiguredDevice() passes this to a filesystem-existence-checked API, so
// it must resolve relative to the process's working directory; bare-name
// deployments must set QRMCI_SUBMITTER_QDMI_DRIVER explicitly.
inline constexpr std::string_view SubmitterqdmiDriver =
    "/usr/local/lib/qrmci/libqdmi_example_driver.so";
inline constexpr std::string_view SubmitterQdmiDeviceName =
    "C++ Device with 5 qubits";
inline constexpr std::string_view SubmitterQdmiDeviceId = "cxxdevice5q";
inline constexpr std::string_view SubmitterQdmiClientToken = "token";

} // namespace mqss::qrmci::defaults
