# Uninstall target
message("Uninstalling...")

set(EXECUTABLE_NAME "@EXECUTABLE_NAME@")
set(CMAKE_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@")

get_filename_component(TOPLEVEL "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
get_filename_component(TOPLEVEL "${TOPLEVEL}" DIRECTORY)

message(STATUS "Removig ${CMAKE_INSTALL_PREFIX}/bin/${EXECUTABLE_NAME}")
message(STATUS "Removig ${CMAKE_INSTALL_PREFIX}/bin/lib/generator_runner directory")
message(STATUS "Removig ${CMAKE_INSTALL_PREFIX}/bin/lib/scheduler_runner directory")
message(STATUS "Removig ${CMAKE_INSTALL_PREFIX}/bin/lib/selector_runner directory")
message(STATUS "Removig ${CMAKE_INSTALL_PREFIX}/bin/lib/pass_runner directory")
#message(STATUS "Removig ${CMAKE_INSTALL_PREFIX}/bin/lib/pass_runner/libQirPassRunner.so")
message(STATUS "Removig ${TOPLEVEL}/docs/build directory")

execute_process(COMMAND ${CMAKE_COMMAND} -E remove ${CMAKE_INSTALL_PREFIX}/bin/${EXECUTABLE_NAME}
                        ${CMAKE_COMMAND} -E remove_directory ${CMAKE_INSTALL_PREFIX}/bin/lib/generator_runner
                        ${CMAKE_COMMAND} -E remove_directory ${CMAKE_INSTALL_PREFIX}/bin/lib/scheduler_runner
                        ${CMAKE_COMMAND} -E remove_directory ${CMAKE_INSTALL_PREFIX}/bin/lib/selector_runner
                        ${CMAKE_COMMAND} -E remove_directory ${CMAKE_INSTALL_PREFIX}/bin/lib/pass_runner
                        ${CMAKE_COMMAND} -E remove_directory ${TOPLEVEL}/docs/build)
